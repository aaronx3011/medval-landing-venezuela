# Local development (docker compose). Copy to .env and fill in values.
# .env is gitignored; never commit real values.
# directConnection=true: host-side commands reach the single-node replica set,
# whose member is advertised as mongo:27017 (a name only docker can resolve).
DATABASE_URL=mongodb://127.0.0.1/medval_ve?directConnection=true
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Only needed when the site and admin live on different origins:
# NEXT_PUBLIC_SERVER_URL=
# NEXT_PUBLIC_GA_ID=
